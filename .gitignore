# ---------------------------------------------------------------- monorepo
node_modules/
.turbo/
.DS_Store
*.pem
.vscode/
.idea/

# Local env files. Anchored so a package's own .env is caught too.
.env
.env.*
!.env.example

# ------------------------------------------------------------------- node
.pnp.*
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --------------------------------------------------------------- next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo
.contentlayer/
.vercel/

# ---------------------------------------------------------------- python
# Anchored to directories that are genuinely Python build output. The
# unanchored versions of these (build/, dist/, lib/, share/) would also
# swallow JavaScript output anywhere in the tree.
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.Python
.venv/
venv/
ENV/

# python tooling caches
.mypy_cache/
.dmypy.json
dmypy.json
.pytest_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.ipynb_checkpoints/
cython_debug/

# coverage
.coverage
.coverage.*
coverage/
coverage.xml
htmlcov/
*.cover

# packaging output, scoped to a python package root rather than any dir
**/src/*.egg-info/
